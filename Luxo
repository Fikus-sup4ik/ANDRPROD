    /**
     * Внедрение базовой таблицы стилей в <head> (без дублирования)
     */
    function injectCoreStyles() {
        try {
            if (document.getElementById(PLUGIN_META.styleId)) {
                return;
            }
            var style = document.createElement('style');
            style.id = PLUGIN_META.styleId;
            style.type = 'text/css';
            style.innerHTML = buildCoreCSS();
            var head = document.head || document.getElementsByTagName('head')[0];
            if (head) {
                head.appendChild(style);
            }
        } catch (e) {
            logError('Не удалось внедрить базовый CSS', e);
        }
    }

    /**
     * Применение динамических CSS-переменных на основе текущих настроек пользователя
     */
    function applyDynamicSettings() {
        try {
            var enabled = getSetting('luxo_enabled');
            var accent = getSetting('luxo_accent');
            var radius = getSetting('luxo_radius');
            var animation = getSetting('luxo_animation');
            var scale = getSetting('luxo_scale');
            var headerOpacity = getSetting('luxo_header_opacity');
            var shadows = getSetting('luxo_shadows');

            var body = document.body;
            if (!body) return;

            // Включение или полное отключение модификации Luxo без удаления плагина
            if (enabled) {
                if (body.className.indexOf('luxo-enabled') === -1) {
                    body.className = (body.className + ' luxo-enabled').replace(/^\s+|\s+$/g, '');
                }
            } else {
                body.className = body.className.replace(/\bluxo-enabled\b/g, '').replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
                return;
            }

            var rgbAccent = hexToRgbString(accent);
            var animSpeed = animation ? '0.22s' : '0s';
            var cardShadow = shadows ? '0 6px 18px rgba(0, 0, 0, 0.55)' : 'none';
            var cardFocusShadow = shadows
                ? '0 12px 28px rgba(0, 0, 0, 0.8), 0 0 16px rgba(' + rgbAccent + ', 0.45)'
                : '0 0 0 2px ' + accent;

            var dynamicCSS = [
                ':root {',
                '    --luxo-bg-main: #090909;',
                '    --luxo-bg-sec: #111111;',
                '    --luxo-surface: #181818;',
                '    --luxo-text-main: #FFFFFF;',
                '    --luxo-text-sub: #A0A0A0;',
                '    --luxo-accent: ' + accent + ';',
                '    --luxo-accent-rgb: ' + rgbAccent + ';',
                '    --luxo-card-radius: ' + radius + 'px;',
                '    --luxo-anim-speed: ' + animSpeed + ';',
                '    --luxo-card-scale: ' + scale + ';',
                '    --luxo-header-alpha: ' + headerOpacity + ';',
                '    --luxo-card-shadow: ' + cardShadow + ';',
                '    --luxo-card-focus-shadow: ' + cardFocusShadow + ';',
                '}'
            ].join('\n');

            var dynStyle = document.getElementById(PLUGIN_META.dynamicStyleId);
            if (!dynStyle) {
                dynStyle = document.createElement('style');
                dynStyle.id = PLUGIN_META.dynamicStyleId;
                dynStyle.type = 'text/css';
                var head = document.head || document.getElementsByTagName('head')[0];
                if (head) {
                    head.appendChild(dynStyle);
                }
            }
            dynStyle.innerHTML = dynamicCSS;
        } catch (e) {
            logError('Ошибка применения динамических настроек Luxo', e);
        }
    }

    // =========================================================================
    // 4. РЕГИСТРАЦИЯ РАЗДЕЛА НАСТРОЕК В LAMPA.SETTINGSAPI
    // =========================================================================
    function registerSettings() {
        if (!window.Lampa || !Lampa.SettingsApi || typeof Lampa.SettingsApi.addComponent !== 'function') {
            logError('Lampa.SettingsApi недоступен в данной сборке.');
            return;
        }

        try {
            // 1. Создание компонента настроек Luxo
            Lampa.SettingsApi.addComponent({
                component: PLUGIN_META.id,
                name: PLUGIN_META.name,
                icon: LUXO_ICON
            });

            // Заголовок секции
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    type: 'title'
                },
                field: {
                    name: 'Основные параметры оформления Luxo'
                }
            });

            // Настройка 1: Включение и отключение Luxo
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_enabled',
                    type: 'trigger',
                    default: DEFAULTS.luxo_enabled
                },
                field: {
                    name: 'Оформление Luxo',
                    description: 'Включить или полностью отключить визуальный стиль Luxo без удаления плагина'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 2: Выбор акцентного цвета
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_accent',
                    type: 'select',
                    values: {
                        '#E50914': 'Netflix Red (#E50914)',
                        '#0A84FF': 'Apple TV Blue (#0A84FF)',
                        '#10B981': 'Emerald Green (#10B981)',
                        '#F59E0B': 'Amber Gold (#F59E0B)',
                        '#8B5CF6': 'Royal Violet (#8B5CF6)',
                        '#E11D48': 'Crimson Rose (#E11D48)'
                    },
                    default: DEFAULTS.luxo_accent
                },
                field: {
                    name: 'Акцентный цвет',
                    description: 'Основной цвет выделения карточек в фокусе, активных кнопок и индикаторов'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 3: Скругление карточек
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_radius',
                    type: 'select',
                    values: {
                        '0': 'Без скругления (0px)',
                        '6': 'Малое (6px)',
                        '12': 'Стандартное Luxo (12px)',
                        '16': 'Крупное (16px)',
                        '22': 'Максимальное (22px)'
                    },
                    default: DEFAULTS.luxo_radius
                },
                field: {
                    name: 'Скругление карточек',
                    description: 'Радиус скругления углов постеров и информационных блоков'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 4: Анимация карточек
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_animation',
                    type: 'trigger',
                    default: DEFAULTS.luxo_animation
                },
                field: {
                    name: 'Плавная анимация интерфейса',
                    description: 'Плавные переходы при перемещении фокуса с пульта (отключите на слабых ТВ)'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 5: Масштаб увеличения карточек при фокусе
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_scale',
                    type: 'select',
                    values: {
                        '1.00': 'Без увеличения (100%)',
                        '1.03': 'Мягкое (103%)',
                        '1.06': 'Стандартное Luxo (106%)',
                        '1.09': 'Выразительное (109%)'
                    },
                    default: DEFAULTS.luxo_scale
                },
                field: {
                    name: 'Масштаб карточек при фокусе',
                    description: 'Степень увеличения карточки фильма при наведении курсора пульта'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 6: Прозрачность верхней панели
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_header_opacity',
                    type: 'select',
                    values: {
                        '1': 'Непрозрачная (100%)',
                        '0.92': 'Слегка прозрачная (92%)',
                        '0.85': 'Стандартная Luxo (85%)',
                        '0.70': 'Полупрозрачная (70%)',
                        '0.50': 'Максимально прозрачная (50%)'
                    },
                    default: DEFAULTS.luxo_header_opacity
                },
                field: {
                    name: 'Прозрачность верхней панели',
                    description: 'Уровень непрозрачности фона шапки навигации'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 7: Включение и отключение теней
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_shadows',
                    type: 'trigger',
                    default: DEFAULTS.luxo_shadows
                },
                field: {
                    name: 'Объёмные тени карточек',
                    description: 'Отображать мягкие тени и свечение вокруг активной карточки'
                },
                onChange: function () {
                    applyDynamicSettings();
                }
            });

            // Настройка 8: Сброс настроек Luxo
            Lampa.SettingsApi.addParam({
                component: PLUGIN_META.id,
                param: {
                    name: 'luxo_reset_btn',
                    type: 'button'
                },
                field: {
                    name: 'Сбросить настройки Luxo',
                    description: 'Восстановить стандартные параметры оформления Luxo по умолчанию'
                },
                onChange: function () {
                    resetLuxoSettings();
                }
            });

            logInfo('Настройки успешно зарегистрированы в Lampa.SettingsApi.');
        } catch (e) {
            logError('Ошибка при регистрации настроек в SettingsApi', e);
        }
    }

    /**
     * Сброс всех параметров Luxo к значениям по умолчанию
     */
    function resetLuxoSettings() {
        try {
            if (!window.Lampa || !Lampa.Storage) return;

            for (var key in DEFAULTS) {
                if (Object.prototype.hasOwnProperty.call(DEFAULTS, key)) {
                    Lampa.Storage.set(key, DEFAULTS[key]);
                }
            }

            applyDynamicSettings();

            if (Lampa.Noty && typeof Lampa.Noty.show === 'function') {
                Lampa.Noty.show('Luxo: Настройки восстановлены по умолчанию');
            }

            // Обновление открытого окна настроек, чтобы отобразить сброшенные значения
            if (Lampa.Settings && typeof Lampa.Settings.update === 'function') {
                Lampa.Settings.update();
            }
        } catch (e) {
            logError('Ошибка при сбросе настроек Luxo', e);
        }
    }

    // =========================================================================
    // 5. ПОДПИСКА НА СОБЫТИЯ LAMPA (STORAGE И ACTIVITY)
    // =========================================================================
    function bindEvents() {
        try {
            // Реакция на изменение любых ключей luxo_* в Storage
            if (Lampa.Storage && Lampa.Storage.listener && typeof Lampa.Storage.listener.follow === 'function') {
                Lampa.Storage.listener.follow('change', function (e) {
                    if (e && e.name && String(e.name).indexOf('luxo_') === 0) {
                        applyDynamicSettings();
                    }
                });
            }

            // При смене экранов (activity) гарантируем, что класс .luxo-enabled на body сохраняется
            if (Lampa.Listener && typeof Lampa.Listener.follow === 'function') {
                Lampa.Listener.follow('activity', function (e) {
                    if (e && e.type === 'start') {
                        applyDynamicSettings();
                    }
                });
            }
        } catch (e) {
            logError('Ошибка при привязке обработчиков событий Lampa', e);
        }
    }

    // =========================================================================
    // 6. ГЛАВНАЯ ТОЧКА ВХОДА И ЗАПУСК ПЛАГИНА
    // =========================================================================
    function initLuxoPlugin() {
        if (!window.Lampa) {
            logError('Объект window.Lampa не найден. Инициализация отменена.');
            return;
        }

        try {
            logInfo('Запуск инициализации плагина...');
            ensureDefaults();
            injectCoreStyles();
            applyDynamicSettings();
            registerSettings();
            bindEvents();
            logInfo('Плагин Luxo успешно инициализирован.');
        } catch (e) {
            logError('Критическая ошибка при инициализации плагина Luxo', e);
        }
    }

    // Ожидание полной готовности приложения Lampa
    if (window.appready) {
        initLuxoPlugin();
    } else if (window.Lampa && Lampa.Listener && typeof Lampa.Listener.follow === 'function') {
        Lampa.Listener.follow('app', function (e) {
            if (e && e.type === 'ready') {
                initLuxoPlugin();
            }
        });
    } else {
        // Резервный механизм ожидания, если скрипт подключён до инициализации объекта Lampa
        var checkAttempts = 0;
        var waitTimer = setInterval(function () {
            checkAttempts++;
            if (window.Lampa && window.appready) {
                clearInterval(waitTimer);
                initLuxoPlugin();
            } else if (window.Lampa && Lampa.Listener && typeof Lampa.Listener.follow === 'function') {
                clearInterval(waitTimer);
                Lampa.Listener.follow('app', function (e) {
                    if (e && e.type === 'ready') {
                        initLuxoPlugin();
                    }
                });
            } else if (checkAttempts > 50) {
                clearInterval(waitTimer);
                logError('Превышено время ожидания загрузки Lampa.');
            }
        }, 200);
    }
})();
