    /**
     * Преобразование HEX-цвета в строку "R, G, B" для использования в rgba()
     */
    function hexToRgbString(hex) {
        var cleanHex = String(hex || '#E50914').replace('#', '');
        if (cleanHex.length === 3) {
            cleanHex = cleanHex[0] + cleanHex[0] + cleanHex[1] + cleanHex[1] + cleanHex[2] + cleanHex[2];
        }
        var num = parseInt(cleanHex, 16);
        if (isNaN(num)) {
            return '229, 9, 20';
        }
        var r = (num >> 16) & 255;
        var g = (num >> 8) & 255;
        var b = num & 255;
        return r + ', ' + g + ', ' + b;
    }

    /**
     * Безопасное чтение настройки из Lampa.Storage
     */
    function getSetting(key) {
        try {
            if (window.Lampa && Lampa.Storage && typeof Lampa.Storage.get === 'function') {
                var val = Lampa.Storage.get(key, DEFAULTS[key]);
                // Приведение типов для булевых значений (в Lampa.Storage триггеры могут храниться как строки 'true'/'false' или boolean)
                if (typeof DEFAULTS[key] === 'boolean') {
                    if (val === 'true' || val === true) return true;
                    if (val === 'false' || val === false) return false;
                    return DEFAULTS[key];
                }
                return String(val);
            }
        } catch (e) {
            logError('Ошибка чтения настройки ' + key, e);
        }
        return DEFAULTS[key];
    }

    /**
     * Инициализация дефолтных значений в Lampa.Storage при первом запуске
     */
    function ensureDefaults() {
        try {
            if (!window.Lampa || !Lampa.Storage) return;
            for (var key in DEFAULTS) {
                if (Object.prototype.hasOwnProperty.call(DEFAULTS, key)) {
                    var current = Lampa.Storage.get(key, null);
                    if (current === null || typeof current === 'undefined' || current === '') {
                        Lampa.Storage.set(key, DEFAULTS[key]);
                    }
                }
            }
        } catch (e) {
            logError('Ошибка записи начальных настроек', e);
        }
    }

